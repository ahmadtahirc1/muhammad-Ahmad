# Copy this file to .env.local for local development, and add the same
# three variables in Vercel → Project Settings → Environment Variables
# for the admin panel to work in production.

# A GitHub fine-grained personal access token scoped to ONLY this repo
# (ahmadtahirc1/muhammad-Ahmad) with "Contents: Read and write" permission.
# Create one at https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# The password you'll type in at /admin/login. Pick anything strong.
ADMIN_PASSWORD=

# A random string used to sign the admin login session cookie.
# Any long random value works — e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
